set linesize 1500
create table Student
(
  s_id number(5) primary key,
  s_name varchar(10) NOT NULL,
  batch number(2),
  age number(2) CHECK (age between 20 and 40),
  phone number(11) UNIQUE
);

create table Course
(
  course_code varchar(6) primary key,
  title varchar(20) UNIQUE,
  credit number(1) CHECK (credit in (3, 1))
);

create table Enroll
(
  student_id number(5),
  course_code varchar(6),
  marks number(3) NOT NULL,
  grade varchar(2) CHECK (grade in
  ('A+', 'A', 'A-', 'B+', 'B-', 'B', 'C+', 'C', 'D', 'F')),
  foreign key (student_id) references Student(s_id),
  foreign key (course_code) references Course(course_code),
  primary key (student_id, course_code)
);

