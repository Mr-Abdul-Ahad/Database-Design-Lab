--nested queries
--find id of students who have enrolled in 'Database Design' course.
select student_id from Enroll where course_code =(select course_code from course where title='Database Design');

-- find names of student who have enrolled in "database design "course and got a+

select s_name from Student where s_id IN(select student_id from Enroll where grade='A+'and course_code=(select course_code from course where title='Database Design'));

