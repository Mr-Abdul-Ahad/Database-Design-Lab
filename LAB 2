create table student
(
  s_id number(5) Primary Key,
  s_name varchar(40) NOT NULL,
  batch number(2),
  age number(2) constraint checkage CHECK(age between 20 and 40),
  phone number(11) UNIQUE,
  gender varchar(10) CHECK(gender in ('Male','Female'))
);
--rename table
alter table student rename to Student_Info;
desc student_info;

--rename column
alter table student_info rename column batch to s_batch;
desc student_info;

-- data type change 
alter table student_info modify s_batch number(3);
